{
  "name": "cardpal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"pnpm --filter @cardpal/client dev\" \"pnpm --filter @cardpal/server dev\"",
    "build": "pnpm --filter @cardpal/shared build && pnpm --filter @cardpal/client build && pnpm --filter @cardpal/server build",
    "start": "pnpm --filter @cardpal/server start",
    "generate-otp": "pnpm --filter @cardpal/server generate-otp"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "~5.9.3"
  }
}
